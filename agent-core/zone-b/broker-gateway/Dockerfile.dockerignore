# BuildKit reads this (Dockerfile.dockerignore) for builds with
# `-f agent-core/zone-b/broker-gateway/Dockerfile agent-core`; the context is agent-core/.
# Allow-list only what the build needs.
*
!shared/proto/*.proto
!shared/proto/generate.sh
!zone-b/broker-gateway/requirements.txt
!zone-b/broker-gateway/broker_gateway
!zone-b/broker-gateway/broker_gateway/**
!zone-b/execution-motor/execution_motor/__init__.py
!zone-b/execution-motor/execution_motor/canonical.py
!zone-b/execution-motor/execution_motor/errors.py
!zone-b/execution-motor/execution_motor/keys.py
!zone-b/execution-motor/execution_motor/verifiers.py
**/__pycache__
