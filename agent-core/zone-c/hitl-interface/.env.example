# AFE HITL interface: server-side environment only. No NEXT_PUBLIC_* variables exist or are read.
# The app exits at startup if HITL_JWT_SECRET is unset, shorter than 32 chars, or a placeholder.

# REQUIRED. Shared HS256 secret used to verify operator tokens. Generate: openssl rand -base64 48
HITL_JWT_SECRET=
# REQUIRED (unless HITL_DEMO_MODE=true outside production). Base URL of the HITL backend, see docs/api-contract.md
# In production it must be https (plain http only for loopback: localhost, 127.x, [::1]); the operator Bearer
# token and HITL_API_TOKEN travel on this connection.
HITL_API_BASE_URL=https://hitl-backend:4000
# Optional service-to-service token, sent to the backend as X-Service-Token
HITL_API_TOKEN=
# REQUIRED when NODE_ENV=production (startup fails without them); optional otherwise.
# Tokens must carry exactly this iss / aud.
HITL_JWT_ISSUER=
HITL_JWT_AUDIENCE=
# Production only: longest accepted token lifetime (exp - iat) in seconds; default 900 (15 min).
# Production tokens must also carry `iat` and a unique `jti` (needed for logout revocation).
HITL_JWT_MAX_LIFETIME_SEC=900
# Backend call timeout in ms (default 5000). On timeout the action is treated as NOT approved.
HITL_API_TIMEOUT_MS=5000
# Four-eyes (two distinct approvers) when quantity >= this many shares (default 1000; 0 = every signal).
# TODO(owner): set the real threshold; the default is a placeholder, not a calibrated value.
HITL_FOUR_EYES_QUANTITY_THRESHOLD=1000
# Optional: also require four-eyes when quantity * limit price >= this USD notional (limit orders only)
HITL_FOUR_EYES_NOTIONAL_THRESHOLD_USD=
# Extra allowed browser origins for mutation requests (comma separated), e.g. behind a TLS-terminating proxy
HITL_ALLOWED_ORIGINS=
# Per-minute limits (in-memory, per process)
HITL_MUTATION_RATE_LIMIT_PER_MIN=10
HITL_LOGIN_RATE_LIMIT_PER_MIN=10
# Local demo only (synthetic data, refused when NODE_ENV=production): HITL_DEMO_MODE=true
