# Copy to .env (git-ignored) and fill EVERY empty value. This file must never contain real secrets.
# `docker compose config` fails loudly on any required variable that is empty or missing.
# Generate random secrets with:  openssl rand -base64 48
# Then run `bash check-env.sh`: it refuses placeholders, short secrets and non-hex Redis passwords (ALI-21).

# ─── LLM gateway (ADR-003 Option 2: LiteLLM proxy outside Zone A, the only LLM-credential holder) ────
# cognitive-core holds no provider credentials: it calls llm-gateway with this key, and only the gateway
# reaches AWS Bedrock. >= 32 random chars, e.g. `openssl rand -hex 32`. cognitive-core refuses placeholders.
LLM_GATEWAY_MASTER_KEY=
# Region that hosts the Bedrock models. Model ids are PLACEHOLDERS in llm-gateway/config.yaml
# (same as cognitive-core/config.py): TODO(owner): verify them in the Bedrock console.
LLM_GATEWAY_AWS_REGION=
# Per-alias rate limits enforced by the gateway (positive integers). TODO(owner): choose; no defaults.
LLM_GATEWAY_BLUE_RPM=
LLM_GATEWAY_BLUE_TPM=
LLM_GATEWAY_RED_RPM=
LLM_GATEWAY_RED_TPM=
LLM_GATEWAY_JUDGE_RPM=
LLM_GATEWAY_JUDGE_TPM=
LLM_GATEWAY_COMPRESSION_RPM=
LLM_GATEWAY_COMPRESSION_TPM=
LLM_GATEWAY_REFLECTOR_RPM=
LLM_GATEWAY_REFLECTOR_TPM=
# Dev only (docker-compose.dev.yml gives them to llm-gateway, never to cognitive-core): a laptop has no
# IAM role. Leave unset in any real deployment, where the gateway uses an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (SSO/STS); may stay empty.
AWS_SESSION_TOKEN=

# ─── Zone A: cognitive-core ──────────────────────────────────────────────────
# Optional. 0 (default) makes every debate abstain. TODO(owner): replace with the position sizer.
COGNITIVE_ORDER_QUANTITY=0
# Position sizer (ALI-160, zone-a/cognitive-core/sizing.py). `fixed` uses COGNITIVE_ORDER_QUANTITY above.
# `vol_scaled`: shares = floor(equity * risk * omega / (price * realized_vol)), capped by the notional below.
# TODO(owner): choose all three; there are no defaults. Equity is a configured figure, not the live account.
COGNITIVE_SIZER=fixed
COGNITIVE_SIZER_EQUITY_USD=
COGNITIVE_SIZER_RISK_PER_TRADE=
COGNITIVE_SIZER_MAX_ORDER_NOTIONAL_USD=
COGNITIVE_STRATEGY_ID=AFE-STRATEGY-001

# ─── Zone A: regime-detector ─────────────────────────────────────────────────
# HMAC key (>= 32 chars) that authenticates persisted HMM model files.
MODEL_HMAC_KEY=

# ─── Zone B: sensory-array (market data) ─────────────────────────────────────
POLYGON_API_KEY=

# ─── Zone B: aegis ───────────────────────────────────────────────────────────
# Host directories mounted read-only. Defaults are under ./secrets/ (git-ignored).
#   AEGIS_CONFIG_DIR: limits.json, identities.json, hsm_pin        (owner-supplied)
#   AEGIS_TLS_DIR:    server.pem, server.key, ca.pem               (mTLS)
#   AEGIS_HSM_MODULE_DIR: vendor PKCS#11 module (.so)
# AEGIS_CONFIG_DIR=./secrets/aegis-config
# AEGIS_TLS_DIR=./secrets/aegis-tls
# AEGIS_HSM_MODULE_DIR=./secrets/hsm
# Supervisor (aegis-supervisor) client identity: ca.pem, client.pem, client.key. Its certificate CN must have the
# roles state-reader + kill-trigger in identities.json. Other roles: cognitive-core signal-submitter,
# market-data (market-data-writer), execution-motor (state-reader, execution-reporter); see zone-b/aegis/README.md.
# AEGIS_SUPERVISOR_TLS_DIR=./secrets/supervisor-tls
# AEGIS_SUPERVISOR_TRIP_AFTER_MS=60000
# First start only: set to 1 so Aegis may boot on an empty state dir, then unset.
AEGIS_ALLOW_FRESH_STATE=
AEGIS_PKCS11_MODULE=
AEGIS_PKCS11_TOKEN_LABEL=
AEGIS_PKCS11_KEY_LABEL=

# ─── Zone B: broker-gateway (ADR-004 Option C) ───────────────────────────────
# The ONLY service that receives the broker credentials (Alpaca PAPER key id + secret). execution-motor
# refuses to start if these reach its environment. Required even in dev (the dev stack still starts the
# gateway; the motor uses its mock broker unless MOTOR_DEV_USE_MOCK_BROKER=0).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper only. The live host is refused unless AFE_ENABLE_LIVE_TRADING / AFE_LIVE_TRADING_CONFIRM are also
# given to the gateway, which compose deliberately does not do.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Host directories mounted read-only (defaults under ./secrets/, git-ignored):
#   GATEWAY_TLS_DIR:       server.pem, server.key, ca.pem (the CA execution-motor's client cert chains to)
#   GATEWAY_CONFIG_DIR:    attestation-keys.json (Aegis's PUBLIC verification keys, same format as the motor's)
#   MOTOR_GATEWAY_TLS_DIR: ca.pem, client.pem, client.key (execution-motor's client identity, CN=execution-motor)
# GATEWAY_TLS_DIR=./secrets/gateway-tls
# GATEWAY_CONFIG_DIR=./secrets/gateway-config
# MOTOR_GATEWAY_TLS_DIR=./secrets/motor-gateway-tls

# ─── Zone B: execution-motor ─────────────────────────────────────────────────
# No defaults on purpose. TODO(owner): choose caps.
MOTOR_MAX_ORDER_NOTIONAL_USD=
MOTOR_MAX_SESSION_NOTIONAL_USD=

# ─── Zone C: audit database (sql/init-audit-db.sh creates the two least-privilege roles) ──────
AUDIT_DB_NAME=trading_audit
AUDIT_DB_USER=audit_admin
AUDIT_DB_PASSWORD=
# >= 16 chars each and different from each other; services only ever receive the APP password.
AFE_AUDIT_OWNER_PASSWORD=
AFE_AUDIT_APP_PASSWORD=

# ─── Zone C: HITL operator terminal ──────────────────────────────────────────
# >= 32 chars, shared HS256 secret used to verify operator tokens.
HITL_JWT_SECRET=
# The terminal's backend URL is fixed in docker-compose.yml (https://hitl-proxy:9443, hitl-proxy's internal
# TLS listener in front of hitl-backend); it is not set here.
HITL_JWT_ISSUER=
HITL_JWT_AUDIENCE=
HITL_API_TOKEN=
HITL_ALLOWED_ORIGINS=
# hitl-proxy (TLS in front of the terminal and hitl-backend). The only HITL host port, HTTPS only.
# TODO(owner): bind address and port for operators; the default is loopback only.
HITL_HTTPS_BIND_ADDR=127.0.0.1
HITL_HTTPS_PORT=8443
# Directory with server.pem/server.key (operator-facing name), internal.pem/internal.key (SAN DNS:hitl-proxy)
# and ca.pem (issuer of internal.pem). Keys readable by uid 101. Default ./secrets/hitl-tls; the dev
# override uses dev-tls/out/hitl-proxy instead. TODO(owner): production certificates.
HITL_TLS_DIR=./secrets/hitl-tls
# HITL backend (ALI-156, compose profile `hitl-backend`). Holds at or above this many shares need two
# distinct approvers (two OIDC subjects, collected one request at a time).
# TODO(owner): choose; 0 means every hold needs two approvers.
HITL_FOUR_EYES_QUANTITY_THRESHOLD=
# Id of the hitl-backend attestor entry in Aegis's identities.json "hold_attestors" (not a secret). Its Ed25519
# seed (64 hex chars) is a file: ${HITL_ATTESTOR_DIR:-./secrets/hitl-attestor}/attestor.seed. The dev override
# uses the dev-tls key instead.
HITL_APPROVAL_ATTESTOR_ID=

# ─── Redis ACL (ALI-20) ─────────────────────────────────────────────────────
# One user per service (see the redis service in docker-compose.yml). URL-safe values only (they are
# embedded in redis:// URLs): use hex, e.g. `openssl rand -hex 24`.
REDIS_SENSORY_PASSWORD=
REDIS_REGIME_PASSWORD=
REDIS_COGNITIVE_PASSWORD=
REDIS_REFDATA_PASSWORD=
REDIS_HEALTHCHECK_PASSWORD=

# ─── QuestDB auth (ALI-20) ───────────────────────────────────────────────────
# HTTP REST/console basic auth (regime-detector reads with these) and PG-wire credentials. QuestDB's
# built-in admin/quest is replaced by these; >= 16-char passwords, e.g. `openssl rand -hex 24`.
QUESTDB_HTTP_USER=
QUESTDB_HTTP_PASSWORD=
QUESTDB_PG_USER=
QUESTDB_PG_PASSWORD=
# ILP writer auth (sensory-array): ECDSA P-256. QuestDB gets the PUBLIC key in auth.conf inside
# QUESTDB_ILP_AUTH_DIR (default ./secrets/questdb-ilp-auth; the dev override mounts dev-tls/out/questdb-ilp).
# KEY_ID is the kid in auth.conf; TOKEN is the base64url private scalar `d` (dev: dev-tls/out/questdb-ilp/ilp-token).
# QUESTDB_ILP_AUTH_DIR=./secrets/questdb-ilp-auth
QUESTDB_ILP_AUTH_KEY_ID=
QUESTDB_ILP_AUTH_TOKEN=

# ─── Chroma token (ALI-20) ───────────────────────────────────────────────────
# Bearer token enforced by the vector-db proxy in front of Chroma, sent by cognitive-core.
# Hex only (it is placed in the proxy config), >= 32 chars: `openssl rand -hex 32`.
CHROMA_AUTH_TOKEN=

# ─── Resource limits (owner decision ALI-20: env-driven, no defaults in compose) ─────
# PROPOSED starting values. NONE of them is profiled: they are guesses to be replaced by measured
# peaks plus headroom. TODO(owner): profile each service under realistic load and set these.
# Format (check-env.sh): MEM = integer + k/m/g (e.g. 512m), CPUS = positive decimal, PIDS = positive
# integer. pids_limit counts THREADS (JVM, tokio blocking pool, gRPC/thread pools), not just processes.
COGNITIVE_CORE_MEM_LIMIT=2g
COGNITIVE_CORE_CPUS=2.0
COGNITIVE_CORE_PIDS_LIMIT=256
# llm-gateway (LiteLLM proxy, Python/uvicorn). PROPOSED, unprofiled like the rest.
LLM_GATEWAY_MEM_LIMIT=1g
LLM_GATEWAY_CPUS=1.0
LLM_GATEWAY_PIDS_LIMIT=256
REGIME_DETECTOR_MEM_LIMIT=1g
REGIME_DETECTOR_CPUS=1.0
REGIME_DETECTOR_PIDS_LIMIT=128
# vector-db = nginx token proxy (one worker per visible host CPU); vector-db-store = Chroma.
VECTOR_DB_MEM_LIMIT=128m
VECTOR_DB_CPUS=0.5
VECTOR_DB_PIDS_LIMIT=128
VECTOR_DB_STORE_MEM_LIMIT=2g
VECTOR_DB_STORE_CPUS=1.0
VECTOR_DB_STORE_PIDS_LIMIT=256
SENSORY_ARRAY_MEM_LIMIT=512m
SENSORY_ARRAY_CPUS=1.0
SENSORY_ARRAY_PIDS_LIMIT=1024
AEGIS_MEM_LIMIT=512m
AEGIS_CPUS=1.0
AEGIS_PIDS_LIMIT=1024
AEGIS_SUPERVISOR_MEM_LIMIT=128m
AEGIS_SUPERVISOR_CPUS=0.25
AEGIS_SUPERVISOR_PIDS_LIMIT=256
EXECUTION_MOTOR_MEM_LIMIT=512m
EXECUTION_MOTOR_CPUS=1.0
EXECUTION_MOTOR_PIDS_LIMIT=256
BROKER_GATEWAY_MEM_LIMIT=256m
BROKER_GATEWAY_CPUS=0.5
BROKER_GATEWAY_PIDS_LIMIT=128
REFDATA_BRIDGE_MEM_LIMIT=256m
REFDATA_BRIDGE_CPUS=0.5
REFDATA_BRIDGE_PIDS_LIMIT=128
# QuestDB is a JVM: its default max heap is a fraction of the container memory limit.
QUESTDB_MEM_LIMIT=4g
QUESTDB_CPUS=2.0
QUESTDB_PIDS_LIMIT=512
# Must stay above Redis --maxmemory 512mb (docker-compose.yml) plus overhead, or the kernel OOM-kills
# Redis before noeviction can refuse writes.
REDIS_MEM_LIMIT=768m
REDIS_CPUS=0.5
REDIS_PIDS_LIMIT=64
POSTGRES_AUDIT_MEM_LIMIT=1g
POSTGRES_AUDIT_CPUS=1.0
POSTGRES_AUDIT_PIDS_LIMIT=256
HITL_BACKEND_MEM_LIMIT=256m
HITL_BACKEND_CPUS=0.5
HITL_BACKEND_PIDS_LIMIT=128
HITL_INTERFACE_MEM_LIMIT=512m
HITL_INTERFACE_CPUS=0.5
HITL_INTERFACE_PIDS_LIMIT=128
# hitl-proxy: nginx, same image and sizing as the vector-db token proxy. PROPOSED, unprofiled.
HITL_PROXY_MEM_LIMIT=128m
HITL_PROXY_CPUS=0.5
HITL_PROXY_PIDS_LIMIT=128
