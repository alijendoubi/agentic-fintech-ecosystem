# ─── LLM API Keys ───────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Market Data ────────────────────────────────────────────────────────────
POLYGON_API_KEY=your-polygon-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FMP_API_KEY=your-financial-modeling-prep-key

# ─── Execution Broker (Alpaca) ───────────────────────────────────────────────
# Paper trading (default dev target)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── HSM (SoftHSM2 for dev, CloudHSM for prod) ──────────────────────────────
HSM_PKCS11_LIB=/usr/lib/softhsm/libsofthsm2.so
HSM_PIN=your-hsm-pin

# ─── Audit Database ──────────────────────────────────────────────────────────
AUDIT_DB_NAME=trading_audit
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=change-me-in-production

# ─── HITL Interface ──────────────────────────────────────────────────────────
HITL_JWT_SECRET=change-me-in-production
