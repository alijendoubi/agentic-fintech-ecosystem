# Copy to .env (git-ignored) and fill EVERY empty value. This file must never contain real secrets.
# `docker compose config` fails loudly on any required variable that is empty or missing.
# Generate random secrets with:  openssl rand -base64 48
# Then run `bash check-env.sh`: it refuses placeholders, short secrets and non-hex Redis passwords (ALI-21).

# ─── LLM gateway (ADR-003 Option 2: LiteLLM proxy outside Zone A, the only LLM-credential holder) ────
# cognitive-core holds no provider credentials: it calls llm-gateway with this key, and only the gateway
# reaches AWS Bedrock. >= 32 random chars, e.g. `openssl rand -hex 32`. cognitive-core refuses placeholders.
LLM_GATEWAY_MASTER_KEY=
# Region that hosts the Bedrock models. Model ids are PLACEHOLDERS in llm-gateway/config.yaml
# (same as cognitive-core/config.py): TODO(owner): verify them in the Bedrock console.
LLM_GATEWAY_AWS_REGION=
# Per-alias rate limits enforced by the gateway (positive integers). TODO(owner): choose; no defaults.
LLM_GATEWAY_BLUE_RPM=
LLM_GATEWAY_BLUE_TPM=
LLM_GATEWAY_RED_RPM=
LLM_GATEWAY_RED_TPM=
LLM_GATEWAY_JUDGE_RPM=
LLM_GATEWAY_JUDGE_TPM=
LLM_GATEWAY_COMPRESSION_RPM=
LLM_GATEWAY_COMPRESSION_TPM=
LLM_GATEWAY_REFLECTOR_RPM=
LLM_GATEWAY_REFLECTOR_TPM=
# Dev only (docker-compose.dev.yml gives them to llm-gateway, never to cognitive-core): a laptop has no
# IAM role. Leave unset in any real deployment, where the gateway uses an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (SSO/STS); may stay empty.
AWS_SESSION_TOKEN=

# ─── Zone A: cognitive-core ──────────────────────────────────────────────────
# Optional. 0 (default) makes every debate abstain. TODO(owner): replace with the position sizer.
COGNITIVE_ORDER_QUANTITY=0
# Position sizer (ALI-160, zone-a/cognitive-core/sizing.py). `fixed` uses COGNITIVE_ORDER_QUANTITY above.
# `vol_scaled`: shares = floor(equity * risk * omega / (price * realized_vol)), capped by the notional below.
# TODO(owner): choose all three; there are no defaults. Equity is a configured figure, not the live account.
COGNITIVE_SIZER=fixed
COGNITIVE_SIZER_EQUITY_USD=
COGNITIVE_SIZER_RISK_PER_TRADE=
COGNITIVE_SIZER_MAX_ORDER_NOTIONAL_USD=
COGNITIVE_STRATEGY_ID=AFE-STRATEGY-001

# ─── Zone A: regime-detector ─────────────────────────────────────────────────
# HMAC key (>= 32 chars) that authenticates persisted HMM model files.
MODEL_HMAC_KEY=

# ─── Zone B: sensory-array (market data) ─────────────────────────────────────
POLYGON_API_KEY=

# ─── Zone B: aegis ───────────────────────────────────────────────────────────
# Host directories mounted read-only. Defaults are under ./secrets/ (git-ignored).
#   AEGIS_CONFIG_DIR: limits.json, identities.json, hsm_pin        (owner-supplied)
#   AEGIS_TLS_DIR:    server.pem, server.key, ca.pem               (mTLS)
#   AEGIS_HSM_MODULE_DIR: vendor PKCS#11 module (.so)
# AEGIS_CONFIG_DIR=./secrets/aegis-config
# AEGIS_TLS_DIR=./secrets/aegis-tls
# AEGIS_HSM_MODULE_DIR=./secrets/hsm
# Supervisor (aegis-supervisor) client identity: ca.pem, client.pem, client.key. Its certificate CN must have the
# roles state-reader + kill-trigger in identities.json. Other roles: cognitive-core signal-submitter,
# market-data (market-data-writer), execution-motor (state-reader, execution-reporter); see zone-b/aegis/README.md.
# AEGIS_SUPERVISOR_TLS_DIR=./secrets/supervisor-tls
# AEGIS_SUPERVISOR_TRIP_AFTER_MS=60000
# First start only: set to 1 so Aegis may boot on an empty state dir, then unset.
AEGIS_ALLOW_FRESH_STATE=
AEGIS_PKCS11_MODULE=
AEGIS_PKCS11_TOKEN_LABEL=
AEGIS_PKCS11_KEY_LABEL=

# ─── Zone B: execution-motor (profile `pending-impl`, not runnable yet) ──────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# No defaults on purpose. TODO(owner): choose caps.
MOTOR_MAX_ORDER_NOTIONAL_USD=
MOTOR_MAX_SESSION_NOTIONAL_USD=

# ─── Zone C: audit database (sql/init-audit-db.sh creates the two least-privilege roles) ──────
AUDIT_DB_NAME=trading_audit
AUDIT_DB_USER=audit_admin
AUDIT_DB_PASSWORD=
# >= 16 chars each and different from each other; services only ever receive the APP password.
AFE_AUDIT_OWNER_PASSWORD=
AFE_AUDIT_APP_PASSWORD=

# ─── Zone C: HITL operator terminal ──────────────────────────────────────────
# >= 32 chars, shared HS256 secret used to verify operator tokens.
HITL_JWT_SECRET=
# No backend exists yet (docs/api-contract.md is PROPOSED); decisions fail closed until one does.
# https only in production; http is accepted only for loopback hosts.
HITL_API_BASE_URL=https://hitl-backend.internal.example
HITL_JWT_ISSUER=
HITL_JWT_AUDIENCE=
HITL_API_TOKEN=
HITL_ALLOWED_ORIGINS=
HITL_HOST_PORT=3000
# HITL backend (ALI-156, compose profile `hitl-backend`). Holds at or above this many shares need two
# approvers, which the backend cannot collect yet (signed second approvals): those holds can only be rejected.
# TODO(owner): choose; 0 means every hold needs two approvers.
HITL_FOUR_EYES_QUANTITY_THRESHOLD=

# ─── Redis ACL (ALI-20) ─────────────────────────────────────────────────────
# One user per service (see the redis service in docker-compose.yml). URL-safe values only (they are
# embedded in redis:// URLs): use hex, e.g. `openssl rand -hex 24`.
REDIS_SENSORY_PASSWORD=
REDIS_REGIME_PASSWORD=
REDIS_COGNITIVE_PASSWORD=
REDIS_REFDATA_PASSWORD=
REDIS_HEALTHCHECK_PASSWORD=
